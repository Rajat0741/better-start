DATABASE_URL=

# Get it from https://better-auth.com/docs/installation#set-environment-variables
# Generate Secret -> copy -> paste here
BETTER_AUTH_SECRET= 
BETTER_AUTH_URL="http://localhost:3000" # Base URL of your app, change in production

# Google OAuth (https://console.cloud.google.com/apis/credentials):
# - Authorized JavaScript origins: http://localhost:3000
# - Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
# (Replace http://localhost:3000 with your production URL when deploying in both of these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
